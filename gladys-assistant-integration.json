      "description": {
        "en": "A traffic jam is detected when at least the given share of the route is in heavy congestion. The travel time is abnormally long when it exceeds the usual one by both the given percentage and the given number of minutes. Both fire scene triggers.",
        "fr": "Un embouteillage est détecté quand au moins la part indiquée du trajet est en circulation dense. La durée est anormalement longue quand elle dépasse la durée habituelle à la fois du pourcentage et du nombre de minutes indiqués. Les deux déclenchent des scènes.",
        "de": "Ein Stau wird erkannt, wenn mindestens der angegebene Anteil der Strecke stark verstopft ist. Die Fahrzeit ist ungewöhnlich lang, wenn sie die übliche sowohl um den angegebenen Prozentsatz als auch um die angegebene Anzahl Minuten überschreitet. Beides löst Szenen aus.",
        "es": "Se detecta un atasco cuando al menos la parte indicada del trayecto tiene tráfico denso. La duración es anormalmente larga cuando supera la habitual tanto en el porcentaje como en el número de minutos indicados. Ambos activan escenas."
      }
    },
    {
      "key": "congestion_threshold_percent",
      "type": "number",
      "label": {
        "en": "Traffic jam: congested share of the route (%)",
        "fr": "Embouteillage : part du trajet encombrée (%)",
        "de": "Stau: verstopfter Anteil der Strecke (%)",
        "es": "Atasco: parte congestionada del trayecto (%)"
      },
      "required": false,
      "default": 10,
      "min": 1,
      "max": 100
    },
    {
      "key": "abnormal_ratio_percent",
      "type": "number",
      "label": {
        "en": "Abnormal: longer than usual by (%)",
        "fr": "Anormal : plus long que d'habitude de (%)",
        "de": "Ungewöhnlich: länger als üblich um (%)",
        "es": "Anormal: más largo de lo habitual en (%)"
      },
      "required": false,
      "default": 30,
      "min": 0,
      "max": 500
    },
    {
      "key": "abnormal_min_delay_minutes",
      "type": "number",
      "label": {
        "en": "Abnormal: and at least (min) late",
        "fr": "Anormal : et au moins (min) de retard",
        "de": "Ungewöhnlich: mind. (min) Verspätung",
        "es": "Anormal: y al menos (min) de retraso"
      },
      "required": false,
      "default": 5,
      "min": 0,
      "max": 600
    }
